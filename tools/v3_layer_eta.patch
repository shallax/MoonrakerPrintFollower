+    @staticmethod
+    def _estimate_remaining_seconds(
+        print_duration: float,
+        file_progress: float,
+        slicer_estimated_time: Optional[float],
+        metadata_lookup_complete: bool,
+    ) -> Optional[float]:
+        """Return a stable remaining-time estimate.
+
+        ``virtual_sdcard.progress`` is byte progress, not time progress.  Large
+        Cura files can put a disproportionate amount of G-code near the start of
+        a print, so blindly extrapolating elapsed/progress can turn a seven-hour
+        slicer estimate into tens of hours.  Moonraker's ``estimated_time`` is
+        the slicer's total-time estimate and is therefore the primary anchor.
+
+        File-position extrapolation is still useful as a fallback and as a small
+        correction when it broadly agrees with the slicer.  Grossly divergent
+        byte-based estimates are deliberately rejected while a slicer estimate
+        exists.
+        """
+        try:
+            elapsed = max(0.0, float(print_duration))
+        except (TypeError, ValueError):
+            elapsed = 0.0
+        try:
+            progress = max(0.0, min(1.0, float(file_progress)))
+        except (TypeError, ValueError):
+            progress = 0.0
+
+        file_remaining: Optional[float] = None
+        if progress >= 0.02 and elapsed >= 60.0:
+            file_total = elapsed / progress
+            file_remaining = max(0.0, file_total - elapsed)
+
+        try:
+            slicer_total = float(slicer_estimated_time or 0.0)
+        except (TypeError, ValueError):
+            slicer_total = 0.0
+
+        if slicer_total > 0.0:
+            slicer_remaining = max(0.0, slicer_total - elapsed)
+            if slicer_remaining > 0.0:
+                if file_remaining is not None:
+                    file_total = elapsed + file_remaining
+                    if 0.60 * slicer_total <= file_total <= 1.75 * slicer_total:
+                        return 0.75 * slicer_remaining + 0.25 * file_remaining
+                return slicer_remaining
+            # Once the real print has exceeded the slicer estimate, a live
+            # progress extrapolation is preferable to permanently displaying 0.
+            return file_remaining if file_remaining is not None else 0.0
+
+        # While Moonraker metadata is still in flight, showing no estimate is
+        # preferable to flashing a wildly inaccurate byte-based ETA.
+        if not metadata_lookup_complete:
+            return None
+        return file_remaining
+
